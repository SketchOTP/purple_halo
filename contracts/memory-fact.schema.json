{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent/contracts/memory-fact.schema.json",
  "title": "Cited Memory Fact",
  "type": "object",
  "required": [
    "fact_id",
    "scope",
    "statement",
    "citations",
    "confidence",
    "last_validated_at"
  ],
  "properties": {
    "fact_id": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "string",
      "enum": ["repo", "task", "workflow", "tool", "user"]
    },
    "statement": { "type": "string", "minLength": 1 },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_type", "locator"],
        "properties": {
          "source_type": { "type": "string", "enum": ["code", "doc", "trace", "eval", "user"] },
          "locator": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "last_validated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
