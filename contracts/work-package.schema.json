{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://purple-halo.local/contracts/work-package.schema.json",
  "title": "WorkPackage",
  "type": "object",
  "required": [
    "work_id",
    "cycle_id",
    "objective",
    "task_type",
    "target_files",
    "proposed_repo_delta",
    "execution_steps",
    "verification_commands",
    "done_when",
    "dispatch_target",
    "handler_inputs",
    "expected_outputs",
    "goal_inputs",
    "research_inputs",
    "verification_basis"
  ],
  "properties": {
    "work_id": { "type": "string" },
    "cycle_id": { "type": "integer" },
    "objective": { "type": "string" },
    "task_type": { "type": "string" },
    "capability": { "type": "string" },
    "why_now": { "type": "string" },
    "inputs_used": { "type": "object" },
    "target_files": { "type": "array", "items": { "type": "string" } },
    "proposed_repo_delta": { "type": "array", "items": { "type": "string" } },
    "execution_steps": { "type": "array" },
    "verification_commands": { "type": "array" },
    "done_when": { "type": "array", "items": { "type": "string" } },
    "dispatch_target": { "type": "string" },
    "handler_inputs": { "type": "object" },
    "expected_outputs": { "type": "array", "items": { "type": "string" } },
    "goal_inputs": { "type": "object" },
    "research_inputs": { "type": "object" },
    "verification_basis": { "type": "object" },
    "selection_rationale": { "type": "string" },
    "evidence_backed": { "type": "boolean" },
    "created_at": { "type": "string" }
  },
  "additionalProperties": true
}
