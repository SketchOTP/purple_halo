{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "purple_halo/contracts/schedule.schema.json",
  "title": "Purple Halo Operator Schedule",
  "type": "object",
  "required": ["enabled", "timezone", "runs"],
  "properties": {
    "enabled": { "type": "boolean" },
    "timezone": { "type": "string", "minLength": 1 },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at"],
        "properties": {
          "at": { "type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$" },
          "label": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
